# Plantilla de la configuracion de firma del APK de produccion.
#
# Copia este archivo como keystore.properties (sin .example) y rellena los
# valores con los que usaste al crear el almacen con keytool. El archivo real
# NO se versiona: lleva las contrasenas de tu llave de firma.
#
#   cp keystore.properties.example keystore.properties
#
# La ruta es relativa a la raiz del proyecto. Si guardas el .jks fuera del
# repositorio, que es lo recomendable, pon aqui la ruta absoluta.

# El alias identifica la llave DENTRO del archivo. Va con el nombre de la app y
# no solo "ollin": si algun dia guardas aqui la llave de otra app de la familia,
# los alias tienen que ser distintos, y dentro de tres anios querras saber cual
# es cual al abrirlo con `keytool -list`.

storeFile=ollin-finanzas-release.jks
storePassword=
keyAlias=ollin-finanzas
keyPassword=
